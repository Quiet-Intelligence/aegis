direction: right

classes: {
  kernel: {
    style: {
      fill: "#a8d0e6"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  control: {
    style: {
      fill: "#f8e9a1"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  memory: {
    style: {
      fill: "#b5e7a0"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  llm: {
    shape: cloud
    style: {
      fill: "#f76c6c"
      stroke: "#37474f"
      stroke-width: 2
      shadow: true
    }
  }
  sandbox: {
    style: {
      fill: "#e0e0e0"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  database: {
    shape: cylinder
  }
}

Container: Container\n(Read-Only Rootfs) { class: sandbox }

bpf_lsm Hooks: { class: kernel }
Ring Buffers: { class: [kernel; database] }
BPF Hash Maps: { class: [kernel; database] }

Go epoll Readers: { class: control }
Temporal Graph Scorer: { 
  class: control 
  shape: diamond
}
AWS Cedar Policy Engine: { class: control }

SQLite Episodic Store: { class: [memory; database] }
Vector Embedder: { class: memory }
LinUCB Bandit: { class: memory }
Offline PRM Training: { class: memory }

Pluggable LLM Adjudicator: { class: llm }

# Flow
Container -> bpf_lsm Hooks: Syscalls { style.animated: true }

bpf_lsm Hooks -> Ring Buffers: Stream Events { style.animated: true }
Ring Buffers -> Go epoll Readers { style.animated: true }

Go epoll Readers -> Temporal Graph Scorer: Bounded Channels { style.animated: true }

Temporal Graph Scorer -> AWS Cedar Policy Engine: Flagged Event
Temporal Graph Scorer -> Vector Embedder: Vectorize

AWS Cedar Policy Engine -> BPF Hash Maps: Compile Policy {
  style.stroke: "#27ae60"
  style.stroke-width: 3
  style.animated: true
}
AWS Cedar Policy Engine -> Pluggable LLM Adjudicator: Policy Miss

Pluggable LLM Adjudicator -> AWS Cedar Policy Engine: Deny Decision { style.animated: true }
Pluggable LLM Adjudicator <-> Vector Embedder

Vector Embedder <-> SQLite Episodic Store

Offline PRM Training -> LinUCB Bandit: Evaluates Trajectories
LinUCB Bandit -> Temporal Graph Scorer: Tunes Thresholds

BPF Hash Maps -> bpf_lsm Hooks: Block Signal {
  style.stroke: "#c0392b"
  style.stroke-width: 3
  style.animated: true
}
