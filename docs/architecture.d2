direction: right

classes: {
  layer: {
    style: {
      fill: "#f8f9fa"
      stroke: "#adb5bd"
      stroke-dash: 5
      stroke-width: 2
      border-radius: 10
      font-size: 20
      bold: true
      shadow: true
    }
  }
  kernel: {
    style: {
      fill: "#a8d0e6"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  control: {
    style: {
      fill: "#f8e9a1"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  memory: {
    style: {
      fill: "#b5e7a0"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  llm: {
    shape: cloud
    style: {
      fill: "#f76c6c"
      stroke: "#37474f"
      stroke-width: 2
      shadow: true
    }
  }
  sandbox: {
    style: {
      fill: "#e0e0e0"
      stroke: "#37474f"
      stroke-width: 2
      border-radius: 8
      shadow: true
    }
  }
  database: {
    shape: cylinder
  }
}

"Layer 0 OS Sandbox": {
  class: layer
  Container: Container\n(Read-Only Rootfs) { class: sandbox }
}

"Layer 1 eBPF Kernel Data Plane": {
  class: layer
  direction: down
  
  bpf_lsm Hooks: { class: kernel }
  Ring Buffers: { class: [kernel; database] }
  BPF Hash Maps: { class: [kernel; database] }
}

"Layer 2 Go Control Plane": {
  class: layer
  direction: down
  
  Go epoll Readers: { class: control }
  Temporal Graph Scorer: { 
    class: control 
    shape: diamond
  }
  AWS Cedar Policy Engine: { class: control }
  Pluggable LLM Adjudicator: { class: llm }
}

"Memory & Learning (AMLL & PRM)": {
  class: layer
  direction: down
  
  Vector Embedder: { class: memory }
  SQLite Episodic Store: { class: [memory; database] }
  LinUCB Bandit: { class: memory }
  Offline PRM Training: { class: memory }
}

# Intra-layer and Inter-layer Connections
"Layer 0 OS Sandbox".Container -> "Layer 1 eBPF Kernel Data Plane"."bpf_lsm Hooks": Syscalls { style.animated: true }

"Layer 1 eBPF Kernel Data Plane"."bpf_lsm Hooks" -> "Layer 1 eBPF Kernel Data Plane"."Ring Buffers": Stream Events { style.animated: true }
"Layer 1 eBPF Kernel Data Plane"."BPF Hash Maps" -> "Layer 1 eBPF Kernel Data Plane"."bpf_lsm Hooks": Block Signal {
  style.stroke: "#c0392b"
  style.stroke-width: 3
  style.animated: true
}

"Layer 1 eBPF Kernel Data Plane"."Ring Buffers" -> "Layer 2 Go Control Plane"."Go epoll Readers": { style.animated: true }
"Layer 2 Go Control Plane"."Go epoll Readers" -> "Layer 2 Go Control Plane"."Temporal Graph Scorer": Bounded Channels { style.animated: true }

"Layer 2 Go Control Plane"."Temporal Graph Scorer" -> "Layer 2 Go Control Plane"."AWS Cedar Policy Engine": Flagged Event
"Layer 2 Go Control Plane"."Temporal Graph Scorer" -> "Memory & Learning (AMLL & PRM)"."Vector Embedder": Vectorize

"Layer 2 Go Control Plane"."AWS Cedar Policy Engine" -> "Layer 1 eBPF Kernel Data Plane"."BPF Hash Maps": Compile Policy {
  style.stroke: "#27ae60"
  style.stroke-width: 3
  style.animated: true
}
"Layer 2 Go Control Plane"."AWS Cedar Policy Engine" -> "Layer 2 Go Control Plane"."Pluggable LLM Adjudicator": Policy Miss

"Layer 2 Go Control Plane"."Pluggable LLM Adjudicator" -> "Layer 2 Go Control Plane"."AWS Cedar Policy Engine": Deny Decision { style.animated: true }
"Layer 2 Go Control Plane"."Pluggable LLM Adjudicator" -> "Memory & Learning (AMLL & PRM)"."Vector Embedder"
"Memory & Learning (AMLL & PRM)"."Vector Embedder" -> "Layer 2 Go Control Plane"."Pluggable LLM Adjudicator"

"Memory & Learning (AMLL & PRM)"."Vector Embedder" -> "Memory & Learning (AMLL & PRM)"."SQLite Episodic Store"
"Memory & Learning (AMLL & PRM)"."SQLite Episodic Store" -> "Memory & Learning (AMLL & PRM)"."Vector Embedder"

"Memory & Learning (AMLL & PRM)"."Offline PRM Training" -> "Memory & Learning (AMLL & PRM)"."LinUCB Bandit": Evaluates Trajectories
"Memory & Learning (AMLL & PRM)"."LinUCB Bandit" -> "Layer 2 Go Control Plane"."Temporal Graph Scorer": Tunes Thresholds
